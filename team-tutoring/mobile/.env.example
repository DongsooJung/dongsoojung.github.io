# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# Google Maps (Google Cloud Console -> Maps SDK for iOS/Android)
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=

# Google Sign-In (Google Cloud Console -> OAuth 2.0 Client IDs)
# Web client ID is used by @react-native-google-signin/google-signin on both platforms
GOOGLE_SIGNIN_WEB_CLIENT_ID=
# iOS URL scheme is the reversed iOS client ID, e.g. com.googleusercontent.apps.1234567890-abc
GOOGLE_SIGNIN_IOS_URL_SCHEME=

# FCM (server-side; keep in Firebase console. No client env needed for base FCM.)
