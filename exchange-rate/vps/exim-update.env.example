# 국내 VPS 환율 자동 갱신 설정 — 복사해서 키를 채우고 chmod 600 으로 보관.
#   cp exim-update.env.example /etc/exim-update.env
#   chmod 600 /etc/exim-update.env

# 수출입은행 인증키 (필수)
EXIM_API_KEY=여기에_수출입은행_인증키

# GitHub Fine-grained PAT (필수) — 이 저장소에 대해 Contents: Read and write 권한만.
# 발급: github.com → Settings → Developer settings → Fine-grained tokens
GH_TOKEN=여기에_github_fine_grained_PAT

# --- 선택 (기본값 사용 가능) ---
# REPO_DIR=/home/ubuntu/exim-dashboard
# BRANCH=main
# REPO_SLUG=DongsooJung/dongsoojung.github.io
# GIT_NAME=exim-vps-bot
# GIT_EMAIL=exim-vps-bot@users.noreply.github.com
